{
  "name": "psbots",
  "version": "0.0.1",
  "description": "A project about a PostScript based programming language for robots",
  "scripts": {
    "clean": "rm -rf **/node_modules **/dist **/coverage",
    "update": "ncu --deep -i --format group --reject @psbots/*",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces  --if-present"
  },
  "engines": {
    "node": ">=26.13.0"
  },
  "workspaces": [
    "./state"
  ],
  "keywords": [
    "postscript",
    "robots",
    "programming"
  ],
  "author": "Arnaud Buchholz <arnaud.buchholz@free.fr>",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.2",
    "@vitest/coverage-v8": "^5.0.5",
    "dpdm": "^4.3.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "eslint-plugin-security": "^4.2.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^76.0.0",
    "globals": "^17.14.0",
    "npm-check-updates": "^23.1.1",
    "prettier": "^3.9.10",
    "reserve": "^2.3.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}