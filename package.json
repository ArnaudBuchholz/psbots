{
  "name": "psbots",
  "version": "0.0.1",
  "description": "A project about a PostScript based programming language for robots",
  "scripts": {
    "clean": "rm -rf **/node_modules **/dist **/coverage",
    "update": "ncu --deep -i --format group --reject @psbots/*",
    "precheck": "npm run build:min",
    "prettier": "prettier --write --log-level warn \"./tools/*.mjs\" \"*.mjs\"",
    "check": "markdownlint *.md --fix && markdownlint docs/**/*.md --fix && eslint ./tools/*.mjs *.mjs --fix && npm run prettier && npm run check --workspaces",
    "pretest": "npm run build:min",
    "test": "npm run test --workspaces --if-present",
    "build:min": "npm run build -w engine -w repl",
    "build": "npm run build --workspaces",
    "build:docs": "npm run build && rm -rf docs/pong/* docs/repl/* && cp -r wi/dist/* docs/repl && cp -r pong/dist/* docs/pong",
    "start:docs": "reserve",
    "cli": "node ./cli/index.js",
    "cli:debug": "node ./cli/index.js --debug",
    "wi": "npm start --workspace wi"
  },
  "engines": {
    "node": ">=24.11.1"
  },
  "workspaces": [
    "./engine",
    "./repl",
    "./cli",
    "./wi",
    "./pong"
  ],
  "keywords": [
    "postscript",
    "robots",
    "programming"
  ],
  "author": "Arnaud Buchholz <arnaud.buchholz@free.fr>",
  "license": "MIT",
  "devDependencies": {
    "@babel/generator": "^7.29.1",
    "@babel/parser": "^7.29.0",
    "@babel/traverse": "^7.29.0",
    "@eslint/js": "^10.0.1",
    "@html-eslint/eslint-plugin": "^0.54.2",
    "@html-eslint/parser": "^0.54.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@stylistic/eslint-plugin-js": "^4.4.1",
    "@types/node": "^24.12.2",
    "@vitest/coverage-v8": "^5.0.5",
    "dpdm": "^4.3.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "eslint-plugin-security": "^4.2.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^76.0.0",
    "globals": "^17.14.0",
    "markdownlint-cli": "^0.49.1",
    "npm-check-updates": "^23.1.1",
    "prettier": "^3.9.10",
    "reserve": "^2.3.4",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
