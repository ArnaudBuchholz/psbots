{
  "name": "@psbots/tokenizer",
  "version": "1.0.0",
  "description": "psbots language tokenizer",
  "scripts": {
    "clean": "rm -rf **/node_modules **/dist **/coverage",
    "lint": "dpdm src/tokenizer.ts --circular --tree false --warning false --skip-dynamic-imports circular && npm run eslint -- --fix --cache --cache-strategy content && npm run prettier && tsc --build --noEmit",
    "eslint": "eslint \"**/*.mjs\" \"./src/**/*.ts\" \"./test/mcp/*.ts\" --concurrency=auto",
    "test": "vitest run --coverage",
    "build": "npx tsc --project tsconfig.cli.json"
  },
  "engines": {
    "node": ">=26.13.0"
  },
  "keywords": [
    "postscript",
    "robots",
    "programming"
  ],
  "author": "Arnaud Buchholz <arnaud.buchholz@free.fr>",
  "license": "MIT",
  "dependencies": {
    "@psbots/types": "1.0.0"
  }
}